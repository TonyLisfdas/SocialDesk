{
  "name": "socialdesk-desktop",
  "productName": "SocialDesk",
  "version": "2.0.0",
  "description": "SocialDesk · 全平台社交工作台 独立桌面版（本地文件存储 + 后台定时发布引擎）",
  "author": "SocialDesk",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "app": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "bridge": "python bridge/social_bridge.py",
    "test:engine": "electron test/engine-test.cjs",
    "dist:win:all": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {}
}
